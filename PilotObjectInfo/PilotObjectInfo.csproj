<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFramework>net48</TargetFramework>
	<LangVersion>10</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>PilotObjectInfo.ext2</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<OutputPath>bin\Debug\</OutputPath>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<WarningLevel>4</WarningLevel>
		<StartAction>Program</StartAction>
		<StartProgram>C:\Program Files\ASCON\Pilot-BIM\Ascon.Pilot.PilotBIM.exe</StartProgram>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<Optimize>true</Optimize>
		<OutputPath>bin\Release\</OutputPath>
		<DebugType>none</DebugType>
	</PropertyGroup>
    <ItemGroup>
		<Content Include=".gitignore" />
	</ItemGroup>
	<ItemGroup>
    <PackageReference Include="Ascon.Pilot.SDK" Version="26.4.0" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="9.1.0.7988" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="SharpVectors" Version="1.8.1" />
    <PackageReference Include="System.ComponentModel.Composition" Version="9.0.3" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="System.Reactive" Version="4.1.6" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.2" />
  </ItemGroup>
	<!-- Список файлов для исключения из архива -->
	<ItemGroup>
		<ZipExcludeFiles Include="Ascon.Pilot.SDK.dll" />
		<ZipExcludeFiles Include="Ascon.Pilot.Theme.dll" />
		<ZipExcludeFiles Include="Ascon.Pilot.SDK.Common.dll" />
		<ZipExcludeFiles Include="Newtonsoft.Json.dll" />
		<ZipExcludeFiles Include="Microsoft.Xaml.Behaviors.dll" />
		<ZipExcludeFiles Include="SharpVectors.Converters.Wpf.dll" />
		<ZipExcludeFiles Include="SharpVectors.Core.dll" />
		<ZipExcludeFiles Include="SharpVectors.Css.dll" />
		<ZipExcludeFiles Include="SharpVectors.Dom.dll" />
		<ZipExcludeFiles Include="SharpVectors.Model.dll" />
		<ZipExcludeFiles Include="SharpVectors.Rendering.Gdi.dll" />
		<ZipExcludeFiles Include="SharpVectors.Rendering.Wpf.dll" />
		<ZipExcludeFiles Include="SharpVectors.Runtime.Wpf.dll" />
		<ZipExcludeFiles Include="System.Buffers.dll" />
		<ZipExcludeFiles Include="System.Numerics.Vectors.dll" />
		<ZipExcludeFiles Include="System.Reactive.dll" />
		<ZipExcludeFiles Include="System.Reactive.Linq.dll" />
		<ZipExcludeFiles Include="System.Threading.Tasks.Extensions.dll" />
		<ZipExcludeFiles Include="System.Runtime.CompilerServices.Unsafe.dll" />
		<ZipExcludeFiles Include="System.Composition.AttributedModel.dll" />
		<ZipExcludeFiles Include="System.Composition.Convention.dll" />
		<ZipExcludeFiles Include="System.Composition.Hosting.dll" />
		<ZipExcludeFiles Include="System.Composition.Runtime.dll" />
		<ZipExcludeFiles Include="System.Composition.TypedParts.dll" />
		<ZipExcludeFiles Include="System.Collections.Immutable.dll" />
		<ZipExcludeFiles Include="System.Memory.dll" />
		<ZipExcludeFiles Include="System.ValueTuple.dll" />
	</ItemGroup>


	<Target Name="CreateZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<Delete Files="$(OutputPath)\*.pdb; $(OutputPath)\*.xml" />

		<!-- Преобразуем список исключений в формат для PowerShell (каждое имя в кавычках, разделенные запятыми) -->
		<PropertyGroup>
			<ExcludeList>@(ZipExcludeFiles->'"%(Identity)"', ',')</ExcludeList>
		</PropertyGroup>

		<!-- Используем PowerShell для создания архива с исключением нужных файлов -->
		<Exec Command="powershell -Command &quot;Get-ChildItem -Path $(OutputPath) -Recurse -Exclude $(ExcludeList) | Compress-Archive -DestinationPath $(OutputPath)\..\$(ProjectName).zip -Force&quot;" />
		<Exec Command="powershell -Command explorer (Split-Path -Path '$(OutputPath)')" />
		<Exec Command="powershell -Command &quot;([System.IO.Path]::GetFullPath('$(OutputPath)..')) | clip &quot;" />
	</Target>


	<PropertyGroup>
		<DebugOutputPath>$(OutputPath)$(AssemblyName)</DebugOutputPath>
		<UserDirectoryPath>$(UserProfile)\AppData\Local\ASCON\Pilot-BIM\Development\$(AssemblyName)</UserDirectoryPath>
	</PropertyGroup>

	<Target Name="CopyToDebugDirectory" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
		<MakeDir Directories="$(UserDirectoryPath)" Condition="!Exists('$(UserDirectoryPath)')" />
		<ItemGroup>
			<FilesToCopy Include="$(OutputPath)**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(FilesToCopy)" DestinationFiles="@(FilesToCopy->'$(UserDirectoryPath)\%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>
</Project>