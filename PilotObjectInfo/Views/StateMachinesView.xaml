<UserControl x:Class="PilotObjectInfo.Views.StateMachinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tools="clr-namespace:Ascon.Pilot.Theme.Tools;assembly=Ascon.Pilot.Theme"         
             xmlns:customcontrols="clr-namespace:PilotObjectInfo.Views.Controls"
             xmlns:viewmodels="clr-namespace:PilotObjectInfo.ViewModels"
             xmlns:converters="clr-namespace:PilotObjectInfo.ViewModels.Converters"
             xmlns:graphcontrols="clr-namespace:GraphShape.Controls;assembly=GraphShape.Controls"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=viewmodels:StateMachinesViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" 
             d:DesignWidth="800">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <tools:SharedResourceDictionary Source="/Ascon.Pilot.Theme;component/Themes/SharedResources/SharedResources.xaml"/>
                <tools:SharedResourceDictionary Source="/Ascon.Pilot.Theme;component/Themes/StandardControls.xaml"/>
                <ResourceDictionary Source="/PilotObjectInfo.ext2;component/Views/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:ByteImageConverter x:Key="ByteImageConverter"/>
            <converters:BidirectionalEdgeRouteToPathConverter x:Key="BidirectionalRouteToPathConverter"/>
            <Style TargetType="{x:Type graphcontrols:VertexControl}">
                <Setter Property="Cursor" Value="Hand"/>
                <EventSetter Event="MouseDoubleClick" Handler="OnVertexMouseDoubleClick"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type graphcontrols:VertexControl}">
                            <Border CornerRadius="4"
                                Padding="8,4"
                                MinWidth="80"
                                ToolTip="{Binding Vertex.DisplayText, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource NormalBackground}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource NormalForeground}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Vertex.IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectedBackground}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorder}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Vertex.Name, RelativeSource={RelativeSource TemplatedParent}}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource NormalForeground}"/>
                                    <TextBlock Text="{Binding Vertex.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource NormalForeground}"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type graphcontrols:EdgeControl}">
                <Setter Property="ToolTip" Value="{Binding DisplayName}"/>
                <Setter Property="Foreground" Value="{DynamicResource NormalForeground}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type graphcontrols:EdgeControl}">
                            <Path Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="{TemplateBinding StrokeThickness}"
                                  MinWidth="1"
                                  MinHeight="1"
                                  ToolTip="{TemplateBinding ToolTip}">
                                <Path.Data>
                                    <MultiBinding Converter="{StaticResource BidirectionalRouteToPathConverter}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                                 Path="Source.(graphcontrols:GraphCanvas.X)"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                                 Path="Source.(graphcontrols:GraphCanvas.Y)"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                                 Path="Source.ActualWidth"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                                 Path="Source.ActualHeight"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                                 Path="Target.(graphcontrols:GraphCanvas.X)"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                                 Path="Target.(graphcontrols:GraphCanvas.Y)"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                                 Path="Target.ActualWidth"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                                 Path="Target.ActualHeight"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                                 Path="RoutePoints"/>
                                        <Binding Path="IsBidirectional"/>
                                    </MultiBinding>
                                </Path.Data>
                            </Path>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Edge.IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource SelectedBackground}"/>
                        <Setter Property="StrokeThickness" Value="2.5"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <customcontrols:SearchPanel Grid.Row="0"/>

        <Popup Style="{StaticResource CopiedPopupStyle}"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
               Child="{StaticResource CopiedPopupContent}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding StateMachinesView}"
                      SelectedItem="{Binding SelectedStateMachine}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      ClipboardCopyMode="ExcludeHeader">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewMouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding CopyCellCommand}"
                                               PassEventArgsToCommand="True"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id"
                                        Binding="{Binding Id}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Title"
                                        Binding="{Binding Title}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1"
                          Width="3"
                          HorizontalAlignment="Center"
                          ResizeBehavior="PreviousAndNext"/>

            <Grid Grid.Column="2" Margin="3,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="140" MinHeight="80"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <customcontrols:StateMachineGraphLayout
                        Graph="{Binding Graph}"
                        LayoutAlgorithmType="Sugiyama"
                        OverlapRemovalAlgorithmType="FSA"
                        MinWidth="400"
                        MinHeight="300"
                        MouseLeftButtonDown="OnGraphMouseLeftButtonDown"/>
                </ScrollViewer>

                <GridSplitter Grid.Row="1"
                              Height="3"
                              HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"/>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding SelectedUserStateItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          ClipboardCopyMode="ExcludeHeader">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding CopyCellCommand}"
                                                   PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Icon">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon, Converter={StaticResource ByteImageConverter}}"
                                           Width="16" Height="16"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Id"
                                            Binding="{Binding Id}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Name}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Title"
                                            Binding="{Binding Title}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Color"
                                            Binding="{Binding Color}"
                                            Width="Auto"/>
                        <DataGridTextColumn Header="IsDeleted"
                                            Binding="{Binding IsDeleted}"
                                            Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
