<UserControl x:Class="PilotObjectInfo.Views.Controls.ToolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PilotObjectInfo.Views.Controls"
             HorizontalAlignment="Stretch"
             mc:Ignorable="d"
             d:DesignHeight="30"
             d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PilotObjectInfo.ext2;component/Views/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Border BorderBrush="{DynamicResource NormalForeground}"
                BorderThickness="1,1,1,1"
                Opacity="0.2"/>
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Path Width="14"
                  Height="14"
                  Margin="4,0,0,0"
                  VerticalAlignment="Center"
                  Stretch="Uniform"
                  Fill="{DynamicResource NormalForeground}"
                  ToolTip="Tools"
                  Data="{StaticResource ToolsGeometry}"/>
            <ContentPresenter Content="{Binding Tools, RelativeSource={RelativeSource AncestorType=local:ToolPanel}}"
                              VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
