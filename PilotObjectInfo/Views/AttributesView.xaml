<UserControl x:Class="PilotObjectInfo.Views.AttributesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PilotObjectInfo" 
             xmlns:viewmodels="clr-namespace:PilotObjectInfo.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:customcontrols="clr-namespace:PilotObjectInfo.Views.Controls"
             d:DataContext="{d:DesignInstance Type=viewmodels:AttributesViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Styles.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="AttributesGrid"
                  Grid.Row="0"
                  ItemsSource="{Binding Attributes}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ClipboardCopyMode="ExcludeHeader">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="PreviewMouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding CopyCellCommand}"
                                           PassEventArgsToCommand="True"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    Width="Auto"
                                    Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Title"
                                    Width="Auto"
                                    Binding="{Binding Title}"/>
                <DataGridTextColumn Header="Value"
                                    Width="Auto"
                                    Binding="{Binding Value}"/>
                <DataGridTextColumn Header="Type"
                                    Width="*"
                                    Binding="{Binding Type}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Popup PlacementTarget="{Binding ElementName=AttributesGrid}"
               Placement="RelativePoint"
               HorizontalOffset="{Binding CopiedPopupX}"
               VerticalOffset="{Binding CopiedPopupY}"
               IsOpen="{Binding IsCopiedPopupOpen}"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True"
               IsHitTestVisible="False">
            <Border Background="{DynamicResource NormalBackground}"
                    BorderBrush="{DynamicResource NormalForeground}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,3">
                <TextBlock Text="Copied!"
                           Margin="0"
                           FontSize="12"
                           Foreground="{DynamicResource NormalForeground}"/>
            </Border>
        </Popup>
        <customcontrols:ToolPanel Grid.Row="2">
            <customcontrols:ToolPanel.Tools>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Style="{StaticResource ToolSeparatorStyle}"/>
                    <Button Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Copy row"
                            Command="{Binding CopyRowCommand}"
                            CommandParameter="{x:Reference AttributesGrid}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="11"
                                  Height="11"
                                  Margin="0,0,2,0"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource NormalForeground}"
                                  Data="{StaticResource CopyGeometry}"/>
                            <Path Height="8"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource NormalForeground}"
                                  Data="{StaticResource RowGeometry}"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparatorStyle}"/>
                    <Button Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Copy as CSV"
                            Command="{Binding CopyCsvCommand}"
                            CommandParameter="{x:Reference AttributesGrid}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="11"
                                  Height="11"
                                  Margin="0,0,2,0"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource NormalForeground}"
                                  Data="{StaticResource CopyGeometry}"/>
                            <Path Height="8"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource NormalForeground}"
                                  Data="{StaticResource CsvGeometry}"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparatorStyle}"/>
                    <Button Style="{StaticResource ToolButtonStyle}"
                            ToolTip="Copy as JSON"
                            Command="{Binding CopyJsonCommand}"
                            CommandParameter="{x:Reference AttributesGrid}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="11"
                                  Height="11"
                                  Margin="0,0,2,0"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource NormalForeground}"
                                  Data="{StaticResource CopyGeometry}"/>
                            <Path Height="8"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource NormalForeground}"
                                  Data="{StaticResource JsonGeometry}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </customcontrols:ToolPanel.Tools>
        </customcontrols:ToolPanel>
    </Grid>
</UserControl>
