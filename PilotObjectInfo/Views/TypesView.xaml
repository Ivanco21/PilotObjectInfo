<UserControl x:Class="PilotObjectInfo.Views.TypesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:customcontrols="clr-namespace:PilotObjectInfo.Views.Controls"
             xmlns:converters="clr-namespace:PilotObjectInfo.ViewModels.Converters"
             xmlns:viewmodels="clr-namespace:PilotObjectInfo.ViewModels" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=viewmodels:TypesViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:ByteImageConverter x:Key="ByteImageConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <customcontrols:SearchPanel/>
            </Grid>
            <Button Grid.Column="1" 
                    Content="to DTO" 
                    Margin="2"
                    Command="{Binding GenerateFullDtoCommand}"
                    CommandParameter="{Binding SelectedType}"/>
            
            <Button Grid.Column="2" 
                    Content="Show random element" 
                    Margin="2"
                    Command="{Binding GoToRandomTypeElementCommand}"
                    CommandParameter="{Binding SelectedType}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="531*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="266*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="TypesGrid"
                          ItemsSource="{Binding TypesView}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          ClipboardCopyMode="ExcludeHeader"
                          SelectedItem="{Binding Path=SelectedType}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding CopyCellCommand}"
                                                   PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding SvgIcon, Converter={StaticResource ByteImageConverter}}"
                                           Width="16" Height="16"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Id" 
                                            Binding="{Binding Id, Mode=OneWay}"/>
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Name, Mode=OneWay}"/>
                        <DataGridTextColumn Header="Title"
                                            Binding="{Binding Title, Mode=OneWay}"/>
                        <DataGridTextColumn Header="Kind"
                                            Binding="{Binding Kind, Mode=OneWay}"/>
                        <DataGridTextColumn Header="IsMountable"
                                            Binding="{Binding IsMountable, Mode=OneWay}"/>
                        <DataGridTextColumn Header="IsDeleted"
                                            Binding="{Binding IsDeleted, Mode=OneWay}"/>
                        <DataGridTextColumn Header="IsProject"
                                            Binding="{Binding IsProject, Mode=OneWay}"/>
                        <DataGridTextColumn Header="IsAdmin"
                                            Binding="{Binding IsService, Mode=OneWay}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <customcontrols:ToolPanel Grid.Row="2">
                    <customcontrols:ToolPanel.Tools>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Style="{StaticResource ToolSeparatorStyle}"/>
                            <Button Style="{StaticResource ToolButtonStyle}"
                                    ToolTip="Copy row"
                                    Command="{Binding CopyRowCommand}"
                                    CommandParameter="{x:Reference TypesGrid}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="11"
                                          Height="11"
                                          Margin="0,0,2,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource NormalForeground}"
                                          Data="{StaticResource CopyGeometry}"/>
                                    <Path Height="8"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource NormalForeground}"
                                          Data="{StaticResource RowGeometry}"/>
                                </StackPanel>
                            </Button>
                            <Rectangle Style="{StaticResource ToolSeparatorStyle}"/>
                            <Button Style="{StaticResource ToolButtonStyle}"
                                    ToolTip="Copy as CSV"
                                    Command="{Binding CopyCsvCommand}"
                                    CommandParameter="{x:Reference TypesGrid}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="11"
                                          Height="11"
                                          Margin="0,0,2,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource NormalForeground}"
                                          Data="{StaticResource CopyGeometry}"/>
                                    <Path Height="8"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource NormalForeground}"
                                          Data="{StaticResource CsvGeometry}"/>
                                </StackPanel>
                            </Button>
                            <Rectangle Style="{StaticResource ToolSeparatorStyle}"/>
                            <Button Style="{StaticResource ToolButtonStyle}"
                                    ToolTip="Copy as JSON"
                                    Command="{Binding CopyJsonCommand}"
                                    CommandParameter="{x:Reference TypesGrid}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="11"
                                          Height="11"
                                          Margin="0,0,2,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource NormalForeground}"
                                          Data="{StaticResource CopyGeometry}"/>
                                    <Path Height="8"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource NormalForeground}"
                                          Data="{StaticResource JsonGeometry}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </customcontrols:ToolPanel.Tools>
                </customcontrols:ToolPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center"/>

            <Grid Grid.Column="2" Margin="3,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="TypeAttrsGrid"
                          ItemsSource="{Binding AttributeDescriptions, UpdateSourceTrigger=PropertyChanged}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          ClipboardCopyMode="ExcludeHeader">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewMouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding CopyCellCommand}"
                                                   PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Name}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Title"
                                            Binding="{Binding Title}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding Type}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Configuration2"
                                            Binding="{Binding Configuration2}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <customcontrols:ToolPanel Grid.Row="2">
                    <customcontrols:ToolPanel.Tools>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Style="{StaticResource ToolSeparatorStyle}"/>
                            <Button Style="{StaticResource ToolButtonStyle}"
                                    ToolTip="Copy row"
                                    Command="{Binding CopyRowCommand}"
                                    CommandParameter="{x:Reference TypeAttrsGrid}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="11"
                                          Height="11"
                                          Margin="0,0,2,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource NormalForeground}"
                                          Data="{StaticResource CopyGeometry}"/>
                                    <Path Height="8"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource NormalForeground}"
                                          Data="{StaticResource RowGeometry}"/>
                                </StackPanel>
                            </Button>
                            <Rectangle Style="{StaticResource ToolSeparatorStyle}"/>
                            <Button Style="{StaticResource ToolButtonStyle}"
                                    ToolTip="Copy as CSV"
                                    Command="{Binding CopyCsvCommand}"
                                    CommandParameter="{x:Reference TypeAttrsGrid}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="11"
                                          Height="11"
                                          Margin="0,0,2,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource NormalForeground}"
                                          Data="{StaticResource CopyGeometry}"/>
                                    <Path Height="8"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource NormalForeground}"
                                          Data="{StaticResource CsvGeometry}"/>
                                </StackPanel>
                            </Button>
                            <Rectangle Style="{StaticResource ToolSeparatorStyle}"/>
                            <Button Style="{StaticResource ToolButtonStyle}"
                                    ToolTip="Copy as JSON"
                                    Command="{Binding CopyJsonCommand}"
                                    CommandParameter="{x:Reference TypeAttrsGrid}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="11"
                                          Height="11"
                                          Margin="0,0,2,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource NormalForeground}"
                                          Data="{StaticResource CopyGeometry}"/>
                                    <Path Height="8"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource NormalForeground}"
                                          Data="{StaticResource JsonGeometry}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </customcontrols:ToolPanel.Tools>
                </customcontrols:ToolPanel>
            </Grid>
        </Grid>

        <Popup Style="{StaticResource CopiedPopupStyle}"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
               Child="{StaticResource CopiedPopupContent}"/>
    </Grid>
</UserControl>
